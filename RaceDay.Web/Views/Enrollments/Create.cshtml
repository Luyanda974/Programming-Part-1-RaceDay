@model RaceDay.Web.Models.EnrollmentFormViewModel

@{
    ViewData["Title"] = "Enrol in an Event";
}

<div class="container mt-5">

    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow">
                <div class="card-body p-4">

                    <h2 class="mb-3">Enrol in an Event</h2>

                    <p class="text-muted">
                        Select an event and choose the category you want to enter.
                    </p>

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.ErrorMessage
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <form asp-controller="Enrollments"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="EventID" class="form-label">
                                Select Event
                            </label>

                            <select name="EventID" class="form-select" id="EventID">
                                <option value="">-- Select an event --</option>

                                @foreach (var raceEvent in Model.Events)
                                {
                                    <option value="@raceEvent.EventID">
                                        @raceEvent.EventName
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="CategoryID" class="form-label">
                                Select Category
                            </label>

                            <select asp-for="CategoryID"
                                    class="form-select"
                                    id="CategoryID"
                                    disabled>

                                <option value="">-- Select a category --</option>

                            </select>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Enrol Now
                        </button>

                    </form>

                    <div class="mt-3 text-center">
                        <a asp-controller="Enrollments"
                           asp-action="Index">
                            Back to My Enrolments
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script>
        // Get the event and category dropdowns.
        const eventDropdown = document.getElementById("EventID");
        const categoryDropdown = document.getElementById("CategoryID");

        // Load categories whenever the participant selects an event.
        eventDropdown.addEventListener("change", async function () {

            // Get the selected event ID.
            const eventID = eventDropdown.value;

            // Clear the previous categories.
            categoryDropdown.innerHTML =
                '<option value="">-- Select a category --</option>';

            // Disable the category dropdown if no event is selected.
            categoryDropdown.disabled = true;

            if (!eventID) {
                return;
            }

            try {
                // Request categories belonging to the selected event.
                const response = await fetch(
                    `/Enrollments/GetCategories?eventID=${eventID}`
                );

                if (!response.ok) {
                    throw new Error("Unable to load categories.");
                }

                        const categories = await response.json();

        // Check what the website received from the controller.
        console.log("Categories received:", categories);

        categories.forEach(function (category) {
            const option = document.createElement("option");

            // Set the category ID as the option value.
            option.value = category.categoryID;

            // Display the category name in the dropdown.
            option.textContent = category.categoryName;

            categoryDropdown.appendChild(option);
        });

                // Enable the dropdown when categories are available.
                categoryDropdown.disabled = categories.length === 0;

                if (categories.length === 0) {
                    categoryDropdown.innerHTML =
                        '<option value="">No categories available</option>';
                }
            }
            catch (error) {
                console.error(error);

                categoryDropdown.innerHTML =
                    '<option value="">Unable to load categories</option>';
            }
        });
    </script>
}
