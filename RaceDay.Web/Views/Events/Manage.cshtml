@model List<RaceDay.Web.Models.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container mt-5">

    <h2>Manage Events</h2>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }
    <a asp-controller="Events"
       asp-action="Create"
       class="btn btn-primary mb-3">
        <i class="bi bi-plus-circle"></i> Create New Event
    </a>
    <p class="text-muted">
        View and manage events created under your organiser account.
    </p>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You have not created any events yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">

                <thead>
                    <tr>
                        <th>Event Name</th>
                        <th>Description</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Distance (km)</th>
                        <th>Actions</th>

                    </tr>
                </thead>

                <tbody>
                    @foreach (var eventItem in Model)
                    {
                        <tr>
                            <td>@eventItem.EventName</td>
                            <td>@eventItem.Description</td>
                            <td>
                                @eventItem.EventDate.ToString("dd MMMM yyyy")
                            </td>
                            <td>@eventItem.Location</td>
                            <td>@eventItem.Distance</td>
                            <td>
                                <a asp-controller="Events"
                                   asp-action="Edit"
                                   asp-route-id="@eventItem.EventID"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>
                            </td>
                            <form asp-controller="Events"
                                  asp-action="Delete"
                                  asp-route-id="@eventItem.EventID"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('Are you sure you want to delete this event?');">
                                    Delete
                                </button>

                            </form>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>

</div>