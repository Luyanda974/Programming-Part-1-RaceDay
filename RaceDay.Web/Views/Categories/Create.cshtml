@model RaceDay.Web.Models.CreateCategoryViewModel

@{
    ViewData["Title"] = "Create Category";
    var events = ViewBag.Events as List<RaceDay.Web.Models.EventViewModel>;
}

<div class="container mt-5">

    <h2>Create Category</h2>

    <p class="text-muted">
        Add a new category to one of your events.
    </p>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <form asp-controller="Categories"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="CategoryName"
                   class="form-label">
                Category Name
            </label>

            <input asp-for="CategoryName"
                   class="form-control"
                   placeholder="Enter category name" />

            <span asp-validation-for="CategoryName"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryType"
                   class="form-label">
                Category Type
            </label>

            <input asp-for="CategoryType"
                   class="form-control"
                   placeholder="Enter category type" />

            <span asp-validation-for="CategoryType"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="EventID"
                   class="form-label">
                Select Event
            </label>

            <select asp-for="EventID"
                    class="form-select">

                <option value="">-- Select an event --</option>

                @if (events != null)
                {
                    @foreach (var eventItem in events)
                    {
                        <option value="@eventItem.EventID">
                            @eventItem.EventName
                        </option>
                    }
                }

            </select>

            <span asp-validation-for="EventID"
                  class="text-danger">
            </span>
        </div>

        <button type="submit"
                class="btn btn-primary">
            Create Category
        </button>

        <a asp-controller="Categories"
           asp-action="Manage"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>
