@{
    ViewData["Title"] = "RaceDay Dashboard";

    string firstName = ViewBag.FirstName ?? "User";
    string lastName = ViewBag.LastName ?? "";
    string role = ViewBag.Role ?? "";
}

<div class="container mt-5">

    <!-- Welcome message -->
    <div class="mb-4">
        <h1>Welcome, @firstName!</h1>
        <p class="text-muted">
            Welcome to your RaceDay dashboard.
        </p>

        <p>
            <strong>Name:</strong> @firstName @lastName
            <br />
            <strong>Role:</strong> @role
        </p>
    </div>

    <hr />

    @if (role == "Participant")
    {
        <!-- Participant dashboard -->
        <h3>Participant Dashboard</h3>
        <p>Manage your race participation from here.</p>

        <div class="row mt-4">

            <div class="col-md-4 mb-3">
                <div class="card shadow h-100">
                    <div class="card-body">
                        <h5>Browse Events</h5>

                        <p>Explore available racing events.</p>

                        <a asp-controller="Events"
                           asp-action="Index"
                           class="btn btn-primary">
                            View Events
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card shadow h-100">
                    <div class="card-body">
                        <h5>My Enrolments</h5>

                        <p>View and manage your event enrolments.</p>

                        <a asp-controller="Enrollments"
                           asp-action="Index"
                           class="btn btn-primary">
                            View Enrolments
                        </a>
                        <a asp-controller="Enrollments"
                           asp-action="Create"
                           class="btn btn-success mt-2">
                            Enrol in an Event
                        </a>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">My Results</h5>

                    <p class="card-text">
                        View your race finishing times and positions.
                    </p>

                    <a asp-controller="Results"
                       asp-action="Index"
                       class="btn btn-primary">
                        View Results
                    </a>
                </div>
            </div>

        </div>
    }
    else if (role == "Organiser")
    {
        <!-- Organiser dashboard -->
        <h3>Organiser Dashboard</h3>
        <p>Manage your racing events from here.</p>

        <div class="row mt-4">
            <div class="col-md-4 mb-3">
                <div class="card shadow h-100">
                    <div class="card-body">
                        <h5>Manage Events</h5>

                        <p>Create, update and manage events.</p>

                        <a asp-controller="Events"
                           asp-action="Manage"
                           class="btn btn-primary">
                            Manage Events
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card shadow h-100">
                    <div class="card-body">
                        <h5>Manage Categories</h5>
                        <p>View and manage event categories.</p>

                        <a asp-controller="Categories"
                           asp-action="Manage"
                           class="btn btn-primary">
                            Manage Categories
                        </a>

                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card shadow h-100">
                    <div class="card-body">
                        <h5>Manage Enrolments</h5>
                        <p>View and manage event enrolments.</p>
                        
                        <a asp-controller="Enrollments"
                           asp-action="Manage"
                           class="btn btn-primary">
                            Manage Enrolments
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card shadow h-100">
                    <div class="card-body">
                        <h5>Manage Results</h5>
                        <p>View and manage event results.</p>
                    </div>
                </div>
            </div>

        </div>
    }
    else
    {
        <p class="text-danger">
            Your account role could not be recognised.
        </p>
    }

    <!-- Logout button -->
    <div class="mt-4">
        <a asp-controller="Auth"
           asp-action="Logout"
           class="btn btn-danger">
            Logout
        </a>
    </div>

</div>